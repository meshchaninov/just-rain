<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
	xmlns:tizen="http://tizen.org/ns/widgets"
	id="https://just-rain.win/tv"
	version="1.0.0"
	viewmodes="maximized">
	<tizen:application id="JRainM5503.JustRainTV" package="JRainM5503" required_version="3.0" />
	<content src="index.html" />
	<feature name="http://tizen.org/feature/screen.size.normal.1080.1920" />
	<icon src="icon.png" />
	<name>Just Rain</name>
	<tizen:profile name="tv-samsung" />
	<tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="3.0" />
	<tizen:setting
		screen-orientation="landscape"
		context-menu="disable"
		background-support="disable"
		encryption="disable"
		install-location="auto"
		hwkey-event="enable"
		pointing-device-support="disable" />
</widget>
